{
  "name": "sme-booking-system",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend and backend workspace for the SME booking system",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm --prefix backend run start",
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "test": "npm --prefix backend run test",
    "test:coverage": "npm --prefix backend run test:coverage"
  }
}
